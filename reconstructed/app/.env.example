# Copy to .env.local and fill in from Firebase Console -> Project settings -> Your apps.
# While these are blank the app runs in DEMO MODE on bundled Alpha Matrix data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ALLOWED_DOMAIN=ghlogisticsllc.com,ajgtransport.com
