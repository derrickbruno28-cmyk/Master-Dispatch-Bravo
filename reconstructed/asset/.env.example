# Firebase web config for the Asset Matrix. Get these from:
#   Firebase Console → Project settings → Your apps → Web app → SDK setup (Config)
# Copy this file to `.env.local` (gitignored) and fill in the real values, then build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: extra allowed sign-in domains (comma-separated). ghlogisticsllc.com and
# ajgtransport.com are ALWAYS allowed and cannot be removed here.
VITE_ALLOWED_DOMAIN=
