:root,
:root[data-theme='dark'] {
  --bg: #0b0d10;
  --panel: #14171c;
  --panel-2: #1c2129;
  --border: #262c36;
  --text: #f2f5f8;
  --muted: #8b98a5;
  --accent: #2f81f7;
  --red: #e5484d;
  --green: #30a46c;
  --amber: #f0b429;
  --shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
  --cell-bg: #0e1116;
  --head-bg: #181e26;
  color-scheme: dark;
}

:root[data-theme='light'] {
  --bg: #f5f6f8;
  --panel: #ffffff;
  --panel-2: #eef0f3;
  --border: #dfe3e8;
  --text: #16191d;
  --muted: #667381;
  --accent: #0a66e8;
  --red: #d93036;
  --green: #1d8a56;
  --amber: #b07f00;
  --shadow: 0 8px 30px rgba(20, 30, 45, 0.12);
  --cell-bg: #fafbfc;
  --head-bg: #eef1f5;
  color-scheme: light;
}

/* ---------- accent palettes (combine with light/dark) ---------- */
:root[data-palette='emerald'] { --accent: #10b981; }
:root[data-palette='emerald'][data-theme='light'] { --accent: #0b8a60; }
:root[data-palette='violet'] { --accent: #8b5cf6; }
:root[data-palette='violet'][data-theme='light'] { --accent: #6d3ee0; }
:root[data-palette='amber'] { --accent: #f59e0b; }
:root[data-palette='amber'][data-theme='light'] { --accent: #b46e00; }
:root[data-palette='crimson'] { --accent: #f04452; }
:root[data-palette='crimson'][data-theme='light'] { --accent: #cf2b39; }

* { box-sizing: border-box; }

html, body, #root { height: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, 'SF Pro Text', 'Segoe UI', system-ui, sans-serif;
  font-size: 13px;
  -webkit-font-smoothing: antialiased;
  transition: background 0.25s ease, color 0.25s ease;
}

.shell { display: flex; flex-direction: column; height: 100vh; }

/* ---------- top bar ---------- */
.topbar {
  display: flex;
  align-items: center;
  gap: 28px;
  padding: 0 20px;
  height: 58px;
  background: var(--panel);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.brand-block { display: flex; align-items: center; gap: 12px; }
.logo-img { height: 38px; width: auto; border-radius: 6px; }
:root[data-theme='dark'] .logo-img { filter: invert(1); }
.logo-fallback {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 900;
  font-size: 24px;
  line-height: 1;
  letter-spacing: -1px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo-fallback small { font-size: 7px; letter-spacing: 2.5px; font-weight: 700; }
.brand { font-weight: 800; font-size: 16px; letter-spacing: 1.5px; white-space: nowrap; }
.brand span { color: var(--accent); }
.brand.big { font-size: 28px; }
.version {
  color: var(--muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin-left: 6px;
}
.topbar nav { display: flex; gap: 2px; }
.topbar nav a {
  color: var(--muted);
  text-decoration: none;
  padding: 8px 15px;
  border-radius: 8px;
  font-weight: 600;
  transition: all 0.15s ease;
}
.topbar nav a:hover { color: var(--text); background: var(--panel-2); }
.topbar nav a.active { color: var(--text); background: var(--panel-2); }
.topbar-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
.badge {
  background: var(--red);
  color: #fff;
  border-radius: 10px;
  padding: 1px 7px;
  font-size: 11px;
  margin-left: 4px;
}
.palette-select {
  padding: 5px 8px;
  font-size: 12px;
  border-radius: 8px;
  background: var(--panel-2);
  color: var(--muted);
}
.demo-badge {
  background: var(--amber);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 6px;
  letter-spacing: 0.5px;
}

/* ---------- buttons & inputs ---------- */
button { font: inherit; cursor: pointer; }
.btn-primary {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 8px 18px;
  font-weight: 600;
  transition: filter 0.15s ease, transform 0.1s ease;
}
.btn-primary:hover { filter: brightness(1.1); }
.btn-primary:active { transform: scale(0.98); }
.btn-primary:disabled { opacity: 0.4; cursor: default; }
.btn-sm { padding: 4px 12px; font-size: 12px; }
.btn-ghost {
  background: transparent;
  color: var(--muted);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 12px;
  transition: all 0.15s ease;
}
.btn-ghost:hover { color: var(--text); border-color: var(--muted); }
.btn-icon { padding: 6px 10px; font-size: 14px; }
.btn-danger {
  background: var(--red);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 8px 16px;
  font-weight: 600;
}
.btn-danger-ghost { color: var(--red); border-color: var(--red); }
input, select, textarea {
  font: inherit;
  background: var(--panel-2);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 7px 10px;
  transition: border-color 0.15s ease;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
}

/* ---------- matrix toolbar ---------- */
.matrix-page { display: flex; flex-direction: column; flex: 1; min-height: 0; }
.toolbar {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 10px 20px;
  flex-wrap: wrap;
  background: var(--panel);
  border-bottom: 1px solid var(--border);
}
.week-nav { display: flex; align-items: center; gap: 8px; }
.week-label { font-weight: 700; min-width: 195px; text-align: center; }
.search { width: 230px; }
.status-chips { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.chip {
  border: 1px solid var(--border);
  background: var(--panel-2);
  color: var(--text);
  border-radius: 20px;
  padding: 3px 11px 3px 23px;
  font-size: 11.5px;
  position: relative;
  transition: all 0.15s ease;
}
.chip::before {
  content: '';
  position: absolute;
  left: 9px; top: 50%;
  transform: translateY(-50%);
  width: 9px; height: 9px;
  border-radius: 50%;
  background: var(--chip);
}
.chip-on { border-color: var(--chip); background: color-mix(in srgb, var(--chip) 22%, var(--panel-2)); }
.exposed-count { color: var(--red); font-weight: 700; margin-left: 8px; }

/* ---------- matrix grid (full-width, frozen lane column) ---------- */
.grid-scroll { overflow: auto; flex: 1; }
.matrix {
  border-collapse: separate;
  border-spacing: 0;
  width: 100%;
  min-width: 1250px; /* below this the grid scrolls horizontally */
  table-layout: fixed;
}
.matrix th, .matrix td {
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 0;
}
.matrix thead th {
  position: sticky;
  top: 0;
  z-index: 3;
  background: var(--head-bg);
  padding: 9px 10px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}
.matrix thead th.today { background: var(--accent); color: #fff; }
.lane-col {
  position: sticky;
  left: 0;
  z-index: 2;
  background: var(--panel) !important;
  width: 280px;
  min-width: 280px;
  max-width: 280px;
  padding: 9px 12px !important;
  text-align: left;
  overflow: hidden; /* lane notes must never bleed into the date grid */
}
.lane-col * { overflow-wrap: anywhere; }
.matrix thead .lane-col { z-index: 4; }
.lane-top { display: flex; align-items: flex-start; gap: 6px; }
.lane-name { font-weight: 700; font-size: 12.5px; line-height: 1.3; flex: 1; }
.lane-edit {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 12px;
  padding: 0 2px;
  opacity: 0;
  transition: opacity 0.15s ease;
}
.lane-col:hover .lane-edit { opacity: 1; }
.lane-edit:hover { color: var(--accent); }
.lane-meta { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 5px; }
.pill {
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 1px 6px;
  font-size: 10px;
  color: var(--muted);
  white-space: nowrap;
}
.pill-trip { color: var(--accent); font-weight: 700; }
.pill-plan { color: var(--amber); }
.pill-role { text-transform: capitalize; }
.lane-target {
  color: var(--muted);
  font-size: 10.5px;
  margin-top: 5px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  max-height: 30px;
  overflow: hidden;
}
.pill-label { color: #12a594; font-weight: 700; }
.cell-static { cursor: default; }
.cell-static:hover { outline: none; }
.trip-label-tag {
  background: color-mix(in srgb, #12a594 15%, var(--panel-2));
  color: #12a594;
  border-radius: 5px;
  font-size: 10.5px;
  font-weight: 800;
  padding: 2px 7px;
  margin-left: 8px;
  vertical-align: 2px;
}
.required { color: var(--red); font-weight: 700; font-size: 11.5px; }
.conflict-warn {
  border: 1px solid var(--amber);
  background: color-mix(in srgb, var(--amber) 10%, var(--panel));
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 12px;
  font-weight: 600;
}
.conflict-hint { color: var(--muted); font-weight: 500; margin-top: 4px; font-size: 11.5px; }
.lane-target b { color: var(--text); font-weight: 600; }

/* section dividers (UMT / Overflow / FA / Empty Trailer) */
.section-row .section-head {
  position: sticky;
  left: 0;
  background: color-mix(in srgb, var(--accent) 14%, var(--panel)) !important;
  border-top: 2px solid var(--accent);
  border-bottom: 2px solid var(--accent);
  padding: 7px 12px !important;
  max-width: none;
  width: auto;
  display: flex;
  align-items: center;
  gap: 14px;
}
.section-title {
  font-weight: 800;
  font-size: 12px;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--accent);
}
.section-alt .lane-col { background: color-mix(in srgb, var(--accent) 4%, var(--panel)) !important; }

.cell {
  height: 60px;
  vertical-align: top;
  cursor: pointer;
  padding: 5px 7px !important;
  background: var(--cell-bg);
  transition: outline 0.1s ease;
  overflow: hidden;
}
.cell:hover { outline: 2px solid var(--accent); outline-offset: -2px; }
.cell.dim { opacity: 0.22; }
.c-load { font-weight: 800; font-size: 12.5px; }
.c-carrier { font-size: 11px; font-weight: 600; margin-top: 1px; overflow-wrap: anywhere; }
.c-rate { font-size: 10.5px; opacity: 0.85; overflow-wrap: anywhere; white-space: pre-line; }
.c-empty { color: var(--border); text-align: center; font-size: 16px; line-height: 48px; }
.c-pending, .c-missing {
  text-align: center;
  padding-top: 10px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.8px;
  color: var(--muted);
}
.c-pending-sub, .c-missing-sub {
  font-weight: 500;
  font-size: 10px;
  letter-spacing: 0.2px;
  margin-top: 2px;
  text-transform: none;
}
.cell-missing {
  background: color-mix(in srgb, var(--amber) 14%, var(--cell-bg)) !important;
  outline: 1.5px dashed var(--amber);
  outline-offset: -2px;
}
.cell-missing .c-missing { color: var(--amber); }

.dedicated-dot { color: #f76b15; margin-left: 5px; font-size: 9px; vertical-align: 2px; }

/* ---------- editor modals ---------- */
.editor-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(3px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.editor {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  width: 410px;
  max-height: 88vh;
  overflow: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: var(--shadow);
}
.editor-wide { width: 620px; }
.editor-head { display: flex; justify-content: space-between; align-items: flex-start; }
.editor-lane { font-weight: 800; font-size: 15px; }
.editor-sub { color: var(--muted); font-size: 12px; margin-top: 2px; }
.editor label, .form-grid label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 12px;
  color: var(--muted);
  font-weight: 600;
}
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; }
.editor-target { color: var(--amber); font-size: 12px; }
.editor-actions { display: flex; gap: 8px; justify-content: flex-end; align-items: center; }
.editor-actions .spacer { flex: 1; }

.dedicated-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid #f76b15;
  background: color-mix(in srgb, #f76b15 10%, var(--panel));
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 12.5px;
}
.dedicated-note { color: var(--muted); font-size: 11.5px; margin-top: 3px; }
.btn-dedicated {
  background: #f76b15;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 7px 14px;
  font-weight: 700;
  white-space: nowrap;
}
.btn-dedicated:hover { filter: brightness(1.1); }
.dedicated-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 12.5px;
}
.dedicated-card.is-dedicated {
  border-color: #f76b15;
  background: color-mix(in srgb, #f76b15 8%, var(--panel));
}
.dedicated-title { color: #f76b15; font-weight: 800; font-size: 11px; letter-spacing: 1px; margin-bottom: 4px; }
.dedicated-fieldset { border-top: 1px solid var(--border); padding-top: 10px; }
.check-row { flex-direction: row !important; align-items: center; gap: 8px !important; margin-bottom: 8px; }
.check-row input { width: auto; }
.grid-span { grid-column: 1 / -1; }

.new-carrier {
  border: 1px solid var(--amber);
  background: color-mix(in srgb, var(--amber) 8%, var(--panel));
  border-radius: 10px;
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.new-carrier-note { font-size: 12px; font-weight: 700; color: var(--amber); }
.optional { font-weight: 400; text-transform: none; }
.carrier-blocked {
  border: 1px solid var(--red);
  background: color-mix(in srgb, var(--red) 8%, var(--panel));
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 12px;
  color: var(--red);
  font-weight: 600;
}

.detail-table { border-collapse: collapse; width: 100%; font-size: 12.5px; }
.detail-table td { padding: 5px 8px; border-bottom: 1px solid var(--border); }
.detail-table tr:last-child td { border-bottom: none; }
.detail-key { color: var(--muted); font-weight: 600; width: 140px; }

.history { border-top: 1px solid var(--border); padding-top: 8px; }
.history-toggle {
  background: none;
  border: none;
  color: var(--muted);
  font-weight: 600;
  font-size: 12px;
  padding: 0;
}
.history-toggle:hover { color: var(--text); }
.history-list { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; max-height: 180px; overflow: auto; }
.history-list li { font-size: 11.5px; line-height: 1.4; }
.history-when { color: var(--muted); margin-right: 8px; }
.history-who { font-weight: 700; margin-right: 8px; }
.history-what { color: var(--muted); }

/* ---------- list pages ---------- */
.page { padding: 18px 24px; overflow: auto; flex: 1; }
.page-head { display: flex; align-items: baseline; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
.page-head h2 { margin: 0; font-size: 20px; letter-spacing: -0.2px; }
.page section h3 { margin: 22px 0 8px; }
.muted { color: var(--muted); font-weight: 400; }
.strong { font-weight: 700; }
.error { color: var(--red); }
.wrap { white-space: normal; overflow-wrap: break-word; }

.list-table {
  border-collapse: collapse;
  width: 100%;
  min-width: 1050px; /* columns stay symmetric; page scrolls sideways instead of collapsing */
  table-layout: fixed;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}
.list-table th {
  text-align: left;
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  padding: 8px 12px;
  border-bottom: 1px solid var(--border);
  background: var(--head-bg);
}
.list-table td {
  padding: 8px 12px;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
  overflow: hidden;
  text-overflow: ellipsis;
}
.list-table tbody tr:last-child td { border-bottom: none; }
.list-table tbody tr:hover { background: var(--panel-2); }
.row-warn { opacity: 0.55; }

/* symmetric column widths — identical in every day-section table */
.w-trip { width: 80px; }
.w-load { width: 85px; }
.w-appt { width: 115px; }
.w-lane { width: auto; }
.w-rate { width: 105px; }
.w-team { width: 100px; }
.w-equip { width: 215px; }
.w-target { width: 210px; }
.w-notes { width: 190px; }
.w-action { width: 90px; }
/* hub: lane column is fixed so the rate sits right next to the trip text; notes flex on the far right.
   min-width guarantees Equipment / Solo-Team text is NEVER clipped — snippets must show full details. */
.hub-table { min-width: 1430px; } /* v2.32.4: fixed columns + guaranteed 200px notes; page scrolls sideways below that (rule 8) */
.hub-table .w-lane { width: 255px; }
.hub-table .w-hubnotes { width: 200px; min-width: 200px; } /* auto collapsed to 0 on narrow screens — notes were invisible (rule 8) */
.hub-table .w-target { width: 125px; }
.hub-table .w-team { width: 118px; }
.hub-table .w-equip { width: 245px; }
.w-pin { width: 40px; }
.hub-table .w-pin { width: 100px; }
.inline-notes { min-width: 150px; }
.note-cell { display: flex; flex-direction: column; gap: 5px; }
.note-log { display: flex; flex-direction: column; gap: 3px; max-height: 90px; overflow-y: auto; }
.note-line { font-size: 11.5px; line-height: 1.35; }
.note-line .note-text { font-weight: 600; }
.note-line .note-meta { color: var(--muted); margin-left: 6px; font-size: 10.5px; white-space: nowrap; }
.note-legacy { color: var(--muted); font-style: italic; }
.note-delete {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 11px;
  padding: 0 4px;
  margin-left: 2px;
}
.note-delete:hover { color: var(--red); }

/* row toggles: night pin + loadboard visibility */
.row-toggles { display: flex; align-items: center; gap: 6px; }
.hide-toggle { background: none; border: none; font-size: 13px; padding: 0; opacity: 0.75; }
.hide-toggle:hover { opacity: 1; }
.hide-toggle.is-hidden { opacity: 1; }
.hub-hidden { color: var(--muted); font-weight: 800; font-size: 11px; }

/* carrier offers inside the hub — §5.4: cards stack left→right, lowest rate first */
.offer-badge { color: #f76b15; font-weight: 700; }
.offer-panel { margin-top: 6px; display: flex; flex-direction: row; flex-wrap: wrap; gap: 6px; align-items: stretch; }
.offer-card {
  display: flex;
  flex-direction: column;
  gap: 4px;
  border: 1px solid #f76b15;
  background: color-mix(in srgb, #f76b15 8%, var(--panel));
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 12px;
  font-weight: 500;
  max-width: 300px;
}
.offer-card.is-countered { border-style: dashed; opacity: 0.92; }
.offer-card .offer-meta { font-size: 11px; line-height: 1.35; }
.offer-countered-line { color: #b46e00; font-weight: 600; font-size: 11.5px; }
.offer-actions { display: flex; align-items: center; gap: 6px; }
.btn-offer-accept, .btn-offer-counter, .btn-offer-deny {
  border: none;
  border-radius: 6px;
  padding: 4px 10px;
  font-weight: 700;
  font-size: 11.5px;
  color: #fff;
}
.btn-offer-accept { background: var(--green); }
.btn-offer-counter { background: var(--accent); }
.btn-offer-counter:disabled { opacity: 0.4; }
.btn-offer-deny { background: var(--red); }
.offer-counter-input { width: 80px; padding: 3px 6px; }
.note-input-row { display: flex; gap: 6px; }
.btn-save-note {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 7px;
  padding: 4px 10px;
  font-weight: 800;
  font-size: 10.5px;
  letter-spacing: 0.5px;
  white-space: nowrap;
}
.btn-save-note:disabled { opacity: 0.35; }
.btn-save-note:hover:not(:disabled) { filter: brightness(1.12); }
.hub-cb { color: #c2255c; font-weight: 800; font-size: 11px; }
.hub-night { color: #5434b4; font-weight: 800; font-size: 11px; }
:root[data-theme='dark'] .hub-night { color: #9a86e8; }
.hub-pinned { background: color-mix(in srgb, #4a2da3 16%, var(--panel)) !important; }
.hub-booked { background: color-mix(in srgb, var(--green) 8%, var(--panel)) !important; }
.hub-booked-line { color: var(--green); font-weight: 700; font-size: 11.5px; margin-top: 3px; }
.hub-target { font-size: 11px; line-height: 1.5; }
.pin-check { width: 15px; height: 15px; accent-color: #4a2da3; cursor: pointer; }
.load-link {
  background: none;
  border: none;
  color: var(--accent);
  font-weight: 700;
  padding: 0;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.load-link:hover { filter: brightness(1.2); }
.btn-approve {
  background: var(--green);
  color: #fff;
  border: none;
  border-radius: 7px;
  padding: 6px 12px;
  font-weight: 700;
  font-size: 12px;
  white-space: nowrap;
}
.btn-approve:hover { filter: brightness(1.1); }
.week-select {
  padding: 7px 8px;
  font-weight: 700;
  min-width: 260px;
}
.group-row .group-head {
  background: var(--head-bg) !important;
  color: var(--muted);
  font-weight: 800;
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 5px 12px !important;
  max-width: none;
  width: auto;
}

/* ---------- sales hub ---------- */
.hub-banner {
  background: var(--head-bg);
  border: 1px solid var(--border);
  padding: 9px 14px;
  border-radius: 10px;
  margin: 18px 0 8px;
  font-size: 13.5px;
  letter-spacing: 0.6px;
}
.hub-lane { font-size: 12.5px; white-space: normal; }
.hub-clear {
  border: 1px dashed var(--border);
  border-radius: 10px;
  padding: 12px 16px;
  color: var(--green);
  font-weight: 600;
  background: color-mix(in srgb, var(--green) 6%, transparent);
}
.inline-select, .inline-input { padding: 4px 8px; font-size: 12px; width: 100%; }
.inline-select { padding-right: 26px; text-overflow: ellipsis; } /* room for the dropdown arrow */

.exposed-day h3 { margin: 20px 0 8px; }
.exposed-table td { font-size: 12.5px; }

/* ---------- import ---------- */
.dropzone {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 2px dashed var(--border);
  border-radius: 12px;
  padding: 26px 22px;
  cursor: pointer;
  color: var(--muted);
  font-weight: 600;
  transition: border-color 0.15s ease, color 0.15s ease;
  margin-bottom: 16px;
}
.dropzone:hover { border-color: var(--accent); color: var(--text); }
.dropzone-icon { font-size: 20px; }
.import-summary { display: flex; align-items: center; gap: 16px; margin: 12px 0; }
.import-summary .ok { color: var(--green); font-weight: 700; }
.import-summary .warn { color: var(--amber); font-weight: 700; }
.import-result { color: var(--green); font-weight: 600; }

/* ---------- integrity (Phase 3) ---------- */
.trm-banner {
  border-radius: 10px;
  padding: 10px 14px;
  margin-bottom: 14px;
  font-size: 12.5px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  border: 1px solid var(--border);
  background: var(--panel);
}
.trm-banner.trm-stale { border-color: var(--amber); background: color-mix(in srgb, var(--amber) 9%, var(--panel)); }
.trm-banner.trm-fresh { border-color: var(--green); }
.trm-upload { cursor: pointer; }
.trm-pending { color: var(--amber); font-weight: 700; }
.integrity-table { min-width: 1180px; }
.wi-trip { width: 110px; }
.wi-lane { width: auto; }
.wi-band { width: 210px; }
.wi-trm { width: 190px; }
.wi-meta { width: 120px; }
.wi-hist { width: 80px; }
.band-cell { display: inline-block; padding: 3px 6px; border-radius: 6px; font-weight: 600; }
.band-cell.editable { cursor: pointer; border: 1px dashed transparent; }
.band-cell.editable:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
.band-editor { display: flex; gap: 5px; align-items: center; flex-wrap: wrap; }
.band-input { width: 70px; padding: 3px 6px; }
.band-reason { width: 110px; padding: 3px 4px; }
.hist-cell { background: var(--panel-2); font-size: 11.5px; }
.band-active { color: var(--text); font-weight: 800; }
.band-live { color: #f76b15; font-weight: 800; font-size: 10px; }
.autoset-btns { margin-left: 14px; display: inline-flex; gap: 6px; }
.btn-autoset {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 7px;
  padding: 4px 12px;
  font-weight: 700;
  font-size: 11.5px;
}
.btn-autoset.ceiling { background: var(--panel-2); color: var(--text); border: 1px solid var(--border); }
.btn-autoset:hover { filter: brightness(1.1); }

/* ---------- admin ---------- */
.admin-users { max-width: 720px; }
/* ---------- permissions editor (v2.11) ---------- */
.perm-editor { width: 760px; }
.perm-tree { display: flex; flex-direction: column; max-height: 60vh; overflow-y: auto; border: 1px solid var(--border); border-radius: 10px; }
.perm-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 12px;
  border-bottom: 1px solid var(--border);
  font-size: 12.5px;
}
.perm-row:last-child { border-bottom: none; }
.perm-row.perm-root { background: var(--head-bg); font-weight: 700; }
.perm-eff { width: 18px; text-align: center; font-weight: 800; }
.perm-eff.on { color: var(--green); }
.perm-eff.off { color: var(--red); }
.perm-label { flex: 1; }
.perm-req { color: var(--muted); font-size: 10px; }
.perm-default { color: var(--muted); font-size: 10.5px; white-space: nowrap; }
.perm-default.on { color: var(--green); }
.perm-mode { width: 92px; padding: 3px 6px; font-size: 11.5px; }
.perm-mode.allow { border-color: var(--green); color: var(--green); font-weight: 700; }
.perm-mode.deny { border-color: var(--red); color: var(--red); font-weight: 700; }
.perm-tuned { color: var(--accent); }

.team-subhead td {
  background: var(--head-bg) !important;
  font-weight: 800;
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--muted);
  padding: 6px 12px !important;
}
.seed-callout {
  border: 1px solid var(--accent);
  background: color-mix(in srgb, var(--accent) 8%, var(--panel));
  border-radius: 12px;
  padding: 16px 20px;
  max-width: 560px;
}
.seed-callout h3 { margin: 0 0 6px; }

/* ---------- carrier loadboard (always light — snippet-ready) ---------- */
.board-shell {
  min-height: 100vh;
  background: #f6f7f9;
  color: #16191d;
  padding: 20px clamp(16px, 4vw, 48px) 60px;
  font-family: -apple-system, 'SF Pro Text', 'Segoe UI', system-ui, sans-serif;
  color-scheme: light;
}
.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}
.board-brand { display: flex; align-items: center; gap: 16px; }
.board-shell .logo-img { filter: none; height: 52px; }
.board-shell h1 { margin: 0; font-size: 24px; letter-spacing: 0.5px; }
.board-shell h1 span { color: #0a66e8; }
.board-sub { color: #667381; font-size: 13px; margin-top: 3px; }
.board-day {
  margin: 26px 0 8px;
  font-size: 16px;
  letter-spacing: 1px;
  border-bottom: 3px solid #0a66e8;
  display: inline-block;
  padding-bottom: 3px;
}
.board-table {
  border-collapse: collapse;
  width: 100%;
  min-width: 980px;
  table-layout: fixed;
  background: #fff;
  border: 1px solid #dfe3e8;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(20, 30, 45, 0.06);
}
.board-table th {
  text-align: left;
  background: #101418;
  color: #fff;
  font-size: 11.5px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  padding: 10px 14px;
}
.board-table td {
  padding: 11px 14px;
  border-bottom: 1px solid #eceff2;
  font-size: 13.5px;
}
.board-table tbody tr:last-child td { border-bottom: none; }
.board-table tbody tr:nth-child(even) { background: #fafbfc; }
.bw-strong { font-weight: 700; }
.bw-rate-val { font-weight: 800; color: #1d8a56; }
/* lane column is fixed so the rate sits right beside the trip text */
.bw-pu { width: 130px; }
.bw-lane { width: 320px; }
.bw-rate { width: 90px; }
.bw-team { width: 95px; }
.bw-equip { width: 240px; }
.bw-comm { width: 100px; }
.bw-offer { width: auto; }
.board-table td.bw-strong { white-space: normal; }
.load-num-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.load-num-row label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); font-weight: 600; }
.load-num-row input:disabled { opacity: 0.65; cursor: not-allowed; }
.board-head-actions { display: flex; gap: 8px; }
/* §5.6: compact Offer button, grouped to the RIGHT of the row's offer column */
.offer-cell { display: flex; flex-direction: column; gap: 5px; align-items: flex-end; }
.btn-offer-compact { padding: 4px 14px !important; font-size: 12px !important; width: auto !important; }

/* §5.1: guided registration steps */
.board-reg-steps { display: flex; flex-direction: column; gap: 10px; max-width: 420px; }
.board-reg-steps label { display: flex; flex-direction: column; gap: 4px; }
.board-reg-steps input { padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border, #d5dbe3); font-size: 14px; }
.reg-step { font-size: 12px; font-weight: 700; letter-spacing: 0.3px; }
.reg-step i { font-weight: 400; color: #667381; }
.reg-hint { color: #b46e00; font-size: 12px; }
.board-count { color: #667381; font-weight: 400; font-size: 14px; }
.btn-send-offer {
  background: #0a66e8;
  color: #fff;
  border: none;
  border-radius: 7px;
  padding: 6px 14px;
  font-weight: 700;
  font-size: 12px;
}
.btn-send-offer:hover:not(:disabled) { filter: brightness(1.1); }
.btn-send-offer:disabled { opacity: 0.4; }
.offer-form { display: flex; flex-direction: column; gap: 5px; }
.offer-form input {
  padding: 5px 8px;
  font-size: 12px;
  border: 1px solid #dfe3e8;
  border-radius: 6px;
  background: #fff;
  color: #16191d;
}
.offer-form-actions { display: flex; gap: 6px; }
.offer-status { font-size: 12px; font-weight: 700; }
.offer-status.pending { color: #b46e00; }
.offer-status.accepted { color: #1d8a56; }
.offer-status.countered { color: #0a66e8; }
.offer-status.denied { color: #d93036; }
.offer-status.locked { color: #8b98a5; font-weight: 600; }

/* carrier registration gate */
.board-gate {
  border-radius: 12px;
  padding: 14px 18px;
  margin: 6px 0 14px;
  font-size: 13px;
  background: #fff;
  border: 1px solid #dfe3e8;
}
.board-gate.pending { border-color: #b46e00; background: #fdf6e8; }
.board-gate.rejected { border-color: #d93036; background: #fdeeee; color: #d93036; font-weight: 600; }
.board-gate.form { display: flex; flex-direction: column; gap: 10px; }
.board-gate .muted-inline { color: #667381; font-size: 12px; }
.board-reg-fields { display: flex; gap: 8px; flex-wrap: wrap; }
.board-reg-fields input {
  padding: 7px 10px;
  font-size: 13px;
  border: 1px solid #dfe3e8;
  border-radius: 7px;
  background: #fff;
  color: #16191d;
  min-width: 170px;
}
.pill-status-pending { color: var(--amber); }
.pill-status-approved { color: var(--green); }
.pill-status-rejected { color: var(--red); }
.board-clear {
  background: #fff;
  border: 1px dashed #dfe3e8;
  border-radius: 10px;
  padding: 14px 18px;
  color: #667381;
}
.board-signin {
  max-width: 460px;
  margin: 12vh auto 0;
  background: #fff;
  border: 1px solid #dfe3e8;
  border-radius: 16px;
  padding: 44px 48px;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-items: center;
  box-shadow: 0 8px 30px rgba(20, 30, 45, 0.1);
}
.board-signin h1 { font-size: 26px; }
.board-fine { color: #8b98a5; font-size: 11.5px; }
.board-shell .btn-ghost { color: #667381; border-color: #dfe3e8; }

/* ---------- sign in ---------- */
.signin {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  color: var(--text);
}
.signin-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 44px 52px;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-items: center;
  box-shadow: var(--shadow);
}
.signin-card .logo-img { height: 64px; }

/* §6.1 shuttles */
.shuttle-toggle { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
.shuttle-box { border: 1px dashed var(--border, #d5dbe3); border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
.shuttle-row { display: flex; gap: 10px; flex-wrap: wrap; }
.shuttle-row label { flex: 1 1 140px; display: flex; flex-direction: column; gap: 3px; font-size: 12px; font-weight: 600; }
.shuttle-pay { font-size: 12px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.shuttle-pay label { display: flex; flex-direction: column; gap: 3px; font-size: 12px; font-weight: 600; max-width: 110px; }
.hub-shuttle { color: #8250df; font-weight: 700; font-size: 11px; }
.board-shuttle { color: #8250df; font-weight: 600; font-size: 12px; margin-top: 2px; }

/* §7.1 dedicated master */
.dedicated-dash { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
.dash-card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 12px 18px; min-width: 150px; }
.dash-value { font-size: 20px; font-weight: 800; }
.dash-bad .dash-value { color: var(--red); }
.dash-label { color: var(--muted); font-size: 11px; margin-top: 2px; }
.dedicated-table th, .dedicated-table td { font-size: 12px; }
.pill-mismatch-carrier, .pill-mismatch-freq { background: var(--red); color: #fff; }
.pill-mismatch-not-marked { background: var(--amber); color: #fff; }
.pill-mismatch-no-lane { background: var(--panel-2); color: var(--muted); }
.dedicated-off-day { border: 1px solid var(--amber); background: color-mix(in srgb, var(--amber) 10%, var(--panel)); border-radius: 8px; padding: 8px 12px; font-size: 12.5px; }

/* §7.2 chargeback box + §7.3 removal prompt */
.cb-box { border: 1px dashed #c2255c; border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
.removal-prompt { border: 1px solid #c2255c; background: color-mix(in srgb, #c2255c 8%, var(--panel)); border-radius: 8px; padding: 10px 12px; font-size: 12.5px; display: flex; flex-direction: column; gap: 4px; }
.removal-issue { color: var(--red); font-weight: 700; }

/* §7.5 board expand */
.board-row { cursor: pointer; }
.board-chev { color: #667381; margin-right: 6px; font-size: 11px; }
.board-detail-row td { background: color-mix(in srgb, var(--accent, #0a66e8) 4%, var(--panel)); }
.board-detail { padding: 8px 12px 8px 30px; font-size: 12.5px; display: flex; flex-direction: column; gap: 4px; }

/* §8 analytics */
.margin-settings { display: flex; gap: 12px; flex-wrap: wrap; }
.margin-settings label { display: flex; flex-direction: column; gap: 3px; font-size: 12px; font-weight: 600; max-width: 160px; }
.margin-table th, .margin-table td { font-size: 12px; }
.m-open { background: var(--panel-2); color: var(--muted); }
.m-notrm { background: var(--amber); color: #fff; }
.m-under { background: #f5d90a; color: #1c1c1c; }
.m-ok { background: var(--green); color: #fff; }
.row-today td { background: color-mix(in srgb, var(--accent) 7%, transparent); }
.top5-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.kpi-good { color: var(--green); font-weight: 700; }
.kpi-bad { color: var(--red); font-weight: 700; }
.neg { color: var(--red); font-weight: 700; }

/* §8.1 print / PDF export */
.print-header { display: none; }
@media print {
  .topbar, .no-print, .page-head input, .page-head button { display: none !important; }
  .print-header { display: block; font-size: 16px; margin-bottom: 12px; }
  .page { padding: 0; }
  body { background: #fff; color: #000; }
}

/* dedicated lanes: orange outline on the lane text (visibility) */
.lane-name.lane-dedicated {
  outline: 1.5px solid #f76b15;
  outline-offset: 2px;
  border-radius: 5px;
}

/* shuttle split cell — legs marked independently */
.cell-split { display: flex; flex-direction: column; height: 100%; min-height: 52px; }
.cell-leg { flex: 1; padding: 2px 6px; overflow: hidden; }
.cell-leg + .cell-leg { border-top: 1px dashed rgba(0,0,0,0.35); }
.cell-leg.leg-exposed { background: var(--red); color: #fff; }
.cell-leg.leg-covered { background: var(--green); color: #fff; }

/* import skipped rows */
.skip-usps { color: var(--red); font-weight: 800; }

/* integrity+dedicated merge */
.embedded-tab .page-head { padding-top: 0; }
.pill-ded { background: #f76b15; color: #fff; cursor: pointer; margin-left: 4px; }

/* assigned-carrier display + remove (input only shows when unassigned) */
.carrier-assigned { display: flex; align-items: center; gap: 10px; padding: 7px 10px; background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px; }
.btn-remove-carrier { color: var(--red); border-color: var(--red); }

/* §shuttle two-column legs: left = pickup/shuttle, right = transit/delivery */
.legs-grid { display: grid; grid-template-columns: 1fr 34px 1fr; gap: 10px; align-items: start; }
.leg-col { display: flex; flex-direction: column; gap: 12px; border: 1px dashed var(--border); border-radius: 10px; padding: 12px; }
.leg-col-2 { border-color: #8250df; }
.leg-head { font-size: 11px; font-weight: 800; letter-spacing: 0.8px; color: var(--muted); }
.leg-arrow { align-self: center; font-size: 22px; font-weight: 800; color: #8250df; text-align: center; }
/* shuttle editor needs width for two columns */
.editor.editor-wide { max-width: 940px; width: min(92vw, 940px); }

/* track & trace */
.row-overdue td { background: color-mix(in srgb, var(--red) 10%, transparent); }
.track-table td { vertical-align: middle; }

/* ---- v2.10.0: 07/09 mega-batch ---- */

/* GH pass-through note in the editor */
.pass-through { padding: 8px 10px; border: 1px dashed var(--border); border-radius: 8px; margin: 6px 0; }

/* shuttle split-cells: room for real notes (Caleb: notes space was condensed) */
.cell-split .cell-leg { min-height: 44px; padding: 4px 6px; }
.cell-split .cell-leg .c-rate { white-space: pre-line; overflow-wrap: anywhere; }
td.cell:has(.cell-split) { min-width: 170px; }

/* swap city/state inputs in the shuttle row */
.shuttle-row .swap-state input { width: 52px; text-transform: uppercase; }

/* T&T action stack */
.track-actions { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }

/* morale team badge — centered in the topbar negative space, on a fixed light
   chip so any team color reads against every palette/theme */
.topbar-gap { flex: 1; display: flex; justify-content: center; min-width: 0; }
.team-badge-wrap { position: relative; }
.team-badge {
  display: flex; align-items: center; gap: 7px; border: 1px solid #d5d5dc;
  background: #ececf1; border-radius: 999px; padding: 3px 12px 3px 5px;
  cursor: pointer; font: inherit; font-size: 12.5px; font-weight: 700; white-space: nowrap;
}
.team-badge:hover { filter: brightness(0.97); }
.team-logo { width: 22px; height: 22px; object-fit: contain; }
.team-mono {
  width: 22px; height: 22px; border-radius: 50%; color: #fff; display: inline-flex;
  align-items: center; justify-content: center; font-size: 10px; font-weight: 800; letter-spacing: 0.3px;
}
.team-pick-hint { color: #555; font-weight: 600; padding-left: 6px; }
.team-picker {
  position: absolute; top: calc(100% + 6px); left: 50%; transform: translateX(-50%);
  background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
  box-shadow: 0 8px 28px rgba(0,0,0,0.25); padding: 8px; width: 260px; z-index: 60;
  display: flex; flex-direction: column; gap: 2px;
}
.team-picker input { width: 100%; box-sizing: border-box; margin-bottom: 4px; }
.team-picker-note { padding: 4px 6px; }
.team-option {
  display: flex; align-items: center; gap: 8px; background: none; border: none;
  padding: 5px 6px; border-radius: 7px; cursor: pointer; color: var(--text);
  font: inherit; font-size: 12.5px; text-align: left;
}
.team-option:hover { background: var(--panel-2); }
.team-clear { color: var(--danger, #d33); }

/* carrier database tab */
.carrier-db-table .w-cname { width: 24%; }
.carrier-db-table .w-cmc { width: 13%; }
.carrier-db-table .w-cdot { width: 13%; }
.carrier-db-table .w-cloads { width: 6%; }
.carrier-db-table .w-cflag { width: 5%; }
.carrier-issue-row td:first-child { color: var(--danger, #d33); }

/* registration ↔ carrier-DB MC link chips */
.mc-link { font-size: 11px; font-weight: 700; margin-top: 2px; }
.mc-known { color: #2f9e44; }
.mc-unknown { color: #e8590c; }

/* ---- v2.11.0 ---- */

/* Integrity: the editable band/TRM cells are now visibly editable */
.edit-hint { opacity: 0.45; margin-left: 5px; font-size: 11px; }
.band-cell.editable { border-color: color-mix(in srgb, var(--accent) 35%, transparent); }
.band-cell.editable:hover .edit-hint { opacity: 1; }

/* Squished topbar (Caleb 07/09): the tab strip scrolls sideways instead of
   crushing; the team badge collapses to logo-only when space runs out */
.topbar nav {
  overflow-x: auto;
  scrollbar-width: none;       /* Firefox */
  -webkit-overflow-scrolling: touch;
  white-space: nowrap;
  min-width: 0;
}
.topbar nav::-webkit-scrollbar { display: none; }
.topbar nav a { flex-shrink: 0; }
@media (max-width: 1280px) {
  .topbar { gap: 14px; }
  .team-name { display: none; }          /* logo-only chip */
  .team-badge { padding: 3px 6px; }
  .team-pick-hint { padding: 0 4px; }
}

/* ---- Mobile (Safari-first) app layout: tabs move to a fixed bottom bar,
   thumb-sized, with safe-area padding for the iPhone home indicator ---- */
@media (max-width: 760px) {
  .topbar {
    gap: 10px;
    padding: 0 12px;
    height: 50px;
    position: sticky; top: 0; z-index: 50;
  }
  .brand { font-size: 13px; letter-spacing: 1px; }
  .logo-img { height: 28px; }
  .version { display: none; }
  .topbar-gap { justify-content: flex-end; }

  /* the SAME nav element becomes the bottom tab bar */
  .topbar nav {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 55;
    display: flex;
    background: var(--panel);
    border-top: 1px solid var(--border);
    padding: 4px 6px calc(4px + env(safe-area-inset-bottom));
    gap: 4px;
  }
  .topbar nav a {
    flex: 1 0 auto;
    text-align: center;
    padding: 10px 12px;          /* 44px-ish touch target */
    font-size: 13px;
  }
  /* content must not hide behind the bar */
  .shell { padding-bottom: calc(56px + env(safe-area-inset-bottom)); }
  .page { padding: 10px; }
  /* editor modal: full-width sheet */
  .editor, .editor.editor-wide { width: 94vw; max-width: 94vw; max-height: 88vh; overflow-y: auto; }
  .legs-grid { grid-template-columns: 1fr; }   /* legs stack on a phone */
  .leg-arrow { transform: rotate(90deg); padding: 2px 0; }
}

/* v2.11.1 — loading-option (equipment) colors: white text on team colors */
.equip-select { font-weight: 700; min-width: 225px; }  /* full option text — never clip (rule 8) */
.equip-select:disabled { opacity: 0.9; }

/* v2.18.0 — permission-denial toast (bottom-right, 5s, store-timed) */
/* v2.19.0 — long-press load move */
.cell-move-src { outline: 3px dashed var(--accent); outline-offset: -3px; opacity: 0.75; }
.cell-move-target { outline: 2px dashed var(--accent); outline-offset: -2px; cursor: copy; }
.cell-move-target:hover { background: color-mix(in srgb, var(--accent) 18%, transparent) !important; }
.move-hint {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 18px;
  z-index: 400;
  background: var(--accent);
  color: #fff;
  font-size: 12.5px;
  font-weight: 700;
  padding: 9px 16px;
  border-radius: 999px;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
}

/* v2.18.0 — Integrity: lanes missing a record + chargeback search bar */
.missing-integrity {
  border: 1px solid #e8590c;
  border-radius: 8px;
  padding: 10px 14px;
  margin: 10px 0;
  font-size: 12.5px;
}
.missing-integrity ul { margin: 6px 0 0; padding-left: 18px; }
.missing-integrity li { margin: 3px 0; }
.missing-integrity button { margin-left: 8px; }
.cb-toolbar { display: flex; gap: 10px; align-items: center; margin: 8px 0; }

.perm-toast {
  position: fixed;
  right: 16px;
  bottom: 16px;
  z-index: 400;
  background: #2b141d;
  color: #ffd9e1;
  border: 1px solid #c2255c;
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 12.5px;
  font-weight: 700;
  max-width: 380px;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  animation: perm-toast-in 0.18s ease-out;
}
@keyframes perm-toast-in {
  from { transform: translateY(8px); opacity: 0; }
  to { transform: none; opacity: 1; }
}

/* v2.11.2 — persistent chargeback visibility. v2.18.0: the strip anchors
   to the BOTTOM of the cell (uniform banner row) instead of hugging the text. */
td.cell { position: relative; }
td.cell:has(.cb-strip) { padding-bottom: 26px; }
.cb-strip {
  position: absolute;
  bottom: 3px;
  left: 3px;
  right: 3px;
  background: #c2255c;           /* the chargeback status color */
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 5px;
  border-radius: 4px;
  overflow-wrap: anywhere;
}
.cb-box.cb-live { border-left: 3px solid #c2255c; }
.cb-waive-note { font-size: 11px; max-width: 240px; overflow-wrap: anywhere; }

/* v2.11.3 — brand block is the home button */
a.brand-block { text-decoration: none; color: inherit; cursor: pointer; border-radius: 8px; }
a.brand-block:hover { opacity: 0.85; }

/* v2.11.4 — the Integrity lane pencil was inheriting Matrix's hover-only
   .lane-edit (opacity 0 outside .lane-col → invisible). Own class, always on. */
.lane-edit-visible {
  border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
  border-radius: 6px;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  white-space: nowrap;
}
.lane-edit-visible:hover { border-color: var(--accent); color: var(--accent); }

/* v2.17.0 — Integrity row pencil sits on its own line UNDER the lane text
   (inline it crowded/overlapped the O/D label). */
.lane-edit-under { display: block; margin-top: 5px; width: max-content; }

/* v2.12.0 — audit-fix batch */
.hub-table td:first-child { white-space: nowrap; }          /* "7523D-7504" no longer wraps */
.site-row td {
  padding: 8px 10px 4px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--muted);
  border-bottom: none;
}
/* mobile editor: keep the shuttle checkbox glued to its label, left-aligned */
@media (max-width: 760px) {
  .editor .shuttle-toggle { justify-content: flex-start; text-align: left; }
}

/* v2.12.1 — band-target ghost in the hub rate column */
.rate-ghost { font-style: italic; opacity: 0.75; }

/* v2.12.3 — the covered sink gets one block header, tinted green */
.site-row-covered td { color: #2f9e44; }

/* ---- v2.14.0: Action Center ---- */
.action-center { position: relative; }
.action-btn { font-weight: 700; white-space: nowrap; }
.action-btn.action-red { color: #ff6b6b; }
.action-panel {
  position: absolute; top: calc(100% + 8px); right: 0; z-index: 70;
  width: min(430px, 92vw); background: var(--panel); border: 1px solid var(--border);
  border-radius: 12px; box-shadow: 0 10px 32px rgba(0,0,0,0.3); padding: 8px;
  display: flex; flex-direction: column; gap: 2px;
}
.action-panel-head { font-size: 12px; font-weight: 800; padding: 6px 8px 8px; }
.action-empty { padding: 12px 8px; color: #2f9e44; font-weight: 600; font-size: 13px; }
.action-item {
  display: flex; align-items: center; gap: 9px; text-align: left;
  background: none; border: none; border-radius: 8px; padding: 8px;
  color: var(--text); font: inherit; font-size: 12.5px; cursor: pointer;
}
.action-item:hover { background: var(--panel-2); }
.action-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.action-dot.red { background: #e03131; }
.action-dot.amber { background: #f59f00; }
.action-count { font-weight: 800; min-width: 30px; text-align: right; flex-shrink: 0; }
.action-text { flex: 1; }
.action-fix { color: var(--accent); font-weight: 700; white-space: nowrap; }

/* ---- v2.14.0: status dropdown with color dots ---- */
.status-select { position: relative; }
.status-trigger {
  display: flex; align-items: center; gap: 8px; width: 100%;
  background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px;
  padding: 7px 10px; color: var(--text); font: inherit; font-size: 13px; cursor: pointer;
  text-align: left;
}
.status-trigger-label { flex: 1; }
.status-caret { color: var(--muted); font-size: 10px; }
.status-dot {
  width: 13px; height: 13px; border-radius: 50%; flex-shrink: 0;
  border: 1.5px solid transparent;
}
.status-menu {
  position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 80;
  background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
  box-shadow: 0 10px 28px rgba(0,0,0,0.35); padding: 5px;
  max-height: 320px; overflow-y: auto;
}
.status-group-label {
  font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase;
  color: var(--muted); padding: 7px 8px 3px;
}
.status-option {
  display: flex; align-items: center; gap: 9px; width: 100%;
  background: none; border: none; border-radius: 7px; padding: 7px 8px;
  color: var(--text); font: inherit; font-size: 13px; cursor: pointer; text-align: left;
}
.status-option:hover { background: var(--panel-2); }
.status-option.is-selected { background: color-mix(in srgb, var(--accent) 14%, transparent); font-weight: 700; }

/* ---- v2.14.1: ☰ settings menu ---- */
.settings-menu { position: relative; }
.settings-btn { font-size: 16px; }
.settings-panel {
  position: absolute; top: calc(100% + 8px); right: 0; z-index: 75;
  width: 270px; background: var(--panel); border: 1px solid var(--border);
  border-radius: 12px; box-shadow: 0 10px 32px rgba(0,0,0,0.3); padding: 10px;
  display: flex; flex-direction: column; gap: 8px;
}
.settings-identity { padding: 2px 4px 8px; border-bottom: 1px solid var(--border); }
.settings-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 12.5px; font-weight: 600; }
.settings-row .palette-select { max-width: 150px; }
.settings-team { display: flex; flex-direction: column; gap: 5px; border-top: 1px solid var(--border); padding-top: 8px; }
.settings-team input { width: 100%; box-sizing: border-box; }
.settings-signout {
  border: 1px solid var(--border); border-radius: 8px; background: none;
  color: var(--danger, #d33); font: inherit; font-size: 12.5px; font-weight: 700;
  padding: 7px; cursor: pointer; margin-top: 2px;
}
.settings-signout:hover { border-color: var(--danger, #d33); }
.settings-version { font-size: 10.5px; text-align: center; padding-top: 2px; }
/* the gap badge is display-only now */
span.team-badge { cursor: default; }

/* ---- v2.15.0: Zack batch ---- */
.hub-soft { background: color-mix(in srgb, #f5d90a 14%, transparent); }
.hub-softbook { color: #b08900; font-weight: 800; }
.carrier-dnu-row td:first-child { color: #e03131; }
.dnu-tag { color: #e03131; font-size: 10.5px; }
.chip-dnu { border-color: #e03131; color: #e03131; }
.cb-correct { display: flex; gap: 4px; margin-top: 3px; }
.lc-input { width: 74px; }
.carrier-db-table .w-cdnu { width: 5%; }
.carrier-db-table .w-cdrivers { width: 20%; }

/* v2.15.1 — partner dispatch pill */
.pill-partner { margin-left: 6px; background: #5b4b8a; color: #fff; font-size: 9.5px; }

/* ---- v2.16.0: T&T Phase 1 ---- */
.track-filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 4px 0 12px; }
.chip-check { display: flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; white-space: nowrap; }
.row-defcon td { background: color-mix(in srgb, #e03131 16%, transparent); }
.row-defcon td:first-child { border-left: 3px solid #e03131; }
.btn-defcon-on { border: 1px solid #e03131; border-radius: 6px; background: color-mix(in srgb, #e03131 22%, transparent); }
.mark-on { color: #2f9e44; font-weight: 700; }
.track-email { white-space: nowrap; }
.facilities-table .w-fsite { width: 24%; }
.facilities-table .w-femails { width: 34%; }
.facilities-table .w-fnotes { width: 28%; }
.fac-input { width: 100%; box-sizing: border-box; }

/* ---- v2.23.0: Bravo Notes batch ---- */
.drag-handle { cursor: grab; color: var(--muted); font-size: 13px; user-select: none; margin-right: 3px; }
tr.drop-target td { border-top: 2px solid var(--accent); }
.svc-flag { color: #e8590c; font-size: 9px; margin-left: 1px; }
.svc-card { border: 1px dashed var(--border); border-radius: 10px; padding: 10px; margin-bottom: 10px; }
.svc-card.has-svc { border-color: #e8590c; }
.svc-title { font-size: 11px; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 5px; color: #e8590c; }
.svc-card textarea { width: 100%; box-sizing: border-box; }
.site-row-soft td { color: #b08900; }

/* ---- v2.24.0: Think Tank batch ---- */
.trk-search { max-width: 110px; }
mark.search-hit { background: #ffe066; color: #1c1c1c; border-radius: 2px; padding: 0 1px; }
.trip-letter { margin-left: 4px; }

/* ---- v2.25.0: Loadout Trailer Module ---- */
.trailer-fieldset { border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 10px; padding: 10px; margin: 6px 0; }
.trailer-hint { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 6px; font-size: 12px; }
.trailers-table .row-overdue td { background: color-mix(in srgb, #e03131 12%, transparent); }
/* v2.28.0 — trailer table refinements: narrow number/date columns, notes
   column, pencil breathing room, clickable rows, exemption manager, detail
   modal. */
.trailers-table td.t-num { max-width: 76px; overflow: hidden; text-overflow: ellipsis; }
.trailers-table td.t-sm { max-width: 62px; }
.trailers-table td.t-notes { max-width: 190px; }
.trailers-table tbody tr { cursor: pointer; }
.pencil-gap { margin-left: 7px; }
.trailer-note-input { width: 170px; font-size: 11px; padding: 1px 5px; }
.exemption-box { border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 10px; padding: 8px 12px; margin: 8px 0; font-size: 12.5px; }
.exemption-list { margin: 6px 0; padding-left: 18px; }
.exemption-list li { margin: 2px 0; }
.exemption-add { display: flex; gap: 8px; align-items: center; }
.trailer-detail { max-width: 560px; }
.trailer-detail-grid { display: grid; grid-template-columns: 120px 1fr; gap: 4px 12px; font-size: 12.5px; margin: 10px 0; }
.trailer-chain { margin: 4px 0 10px; padding-left: 18px; font-size: 12px; }
.trailer-detail-notes { display: block; font-size: 12px; }
.trailer-detail-notes textarea { width: 100%; margin-top: 4px; }

/* v2.27.0 — dense trailers table (Caleb: fit as many rows as possible, keep
   text on one line; the page scrolls sideways instead — rule 8) */
.trailers-table th, .trailers-table td { padding: 2px 6px; font-size: 11.5px; line-height: 1.3; white-space: nowrap; }
.trailers-table td.wrap { white-space: nowrap; max-width: 260px; overflow: hidden; text-overflow: ellipsis; }
.trailers-table .btn-ghost.btn-sm, .trailers-table .btn-approve { padding: 0 6px; font-size: 10.5px; }
/* v2.27.0 — Matrix L.O.T chip */
.lot-tag {
  display: inline-block;
  margin-top: 2px;
  padding: 1px 5px;
  border-radius: 4px;
  background: #31536e;
  color: #fff;
  font-size: 9.5px;
  font-weight: 800;
  letter-spacing: 0.3px;
  white-space: nowrap;
}
.trailer-days { display: block; margin-top: 6px; }
.trailer-days select { margin-left: 6px; }
.trailer-closed td { opacity: 0.55; }
.fine-input { width: 70px; margin-left: 4px; }
td .neg { color: #e03131; }

/* v2.26.0 — Rate Check tab (port of the ghl-ratecheck dispatcher tool) */
.rc-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px 20px;
  max-width: 560px;
  margin-bottom: 16px;
}
.rc-card h3 { margin-top: 0; }
.rc-row { display: flex; gap: 10px; margin-bottom: 10px; align-items: flex-end; }
.rc-row label {
  display: flex; flex-direction: column; gap: 4px;
  font-size: 12px; color: var(--muted); flex: 1;
}
.rc-row .rc-state { max-width: 110px; }
.rc-warn {
  margin-top: 14px; padding: 12px 14px; border-radius: 10px;
  border: 1px solid var(--amber);
  background: color-mix(in srgb, var(--amber) 10%, transparent);
  font-size: 13px;
}
.rc-warn p { margin: 6px 0 10px; }
.rc-verdict {
  display: flex; align-items: center; gap: 12px;
  margin-top: 16px; padding: 14px 16px; border-radius: 10px;
  font-size: 16px; font-weight: 700;
}
.rc-verdict .rc-mark { font-size: 26px; line-height: 1; }
.rc-green { background: color-mix(in srgb, #1d7a3e 14%, transparent); color: #1d7a3e; border: 1px solid #1d7a3e; }
.rc-red { background: color-mix(in srgb, var(--red) 12%, transparent); color: var(--red); border: 1px solid var(--red); }
.rc-error { background: color-mix(in srgb, var(--amber) 12%, transparent); color: var(--amber); border: 1px solid var(--amber); }
.rc-missing {
  font-size: 12px; background: var(--panel-2); border: 1px solid var(--border);
  border-radius: 8px; padding: 10px; white-space: pre-wrap;
}
@media (max-width: 760px) {
  .rc-card { max-width: none; }
}

/* ---- v2.29.0: Rate Con module ---- */
.rc-panel { border: 1px dashed color-mix(in srgb, #2563eb 45%, transparent); border-radius: 10px; padding: 10px; margin: 8px 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
.rc-status { font-size: 12.5px; }
.rc-signed { color: #16a34a; font-weight: 700; }
.rc-sent { color: #d97706; font-weight: 600; }
.facilities-table .w-faddr { width: 24%; }

/* ---- v2.30.0 ---- */
/* #1 board detail: pin BOTH bg and text to the same theme context so a
   forced-dark browser can't leave dark text on a light strip (or vice versa) */
.board-detail-row td { background: var(--panel-2); }
.board-detail { color: var(--text); }
.board-detail b { color: var(--text); }

/* #6/#7 compact rows — mirror the dense Trailers table on T&T + Admin users */
.list-table.track-table th, .list-table.track-table td,
.list-table.admin-users th, .list-table.admin-users td { padding: 3px 8px; font-size: 12px; line-height: 1.3; }
.admin-users { max-width: none; }
/* keep the grouped subheader rows dense too (they carry an !important pad) */
.admin-users .team-subhead td { padding: 4px 8px !important; }

/* #5 settings-menu action button (Import) */
.settings-action { border: 1px solid var(--border); border-radius: 8px; background: none; color: var(--text);
  font: inherit; font-size: 12.5px; font-weight: 700; padding: 7px; cursor: pointer; text-align: left; }
.settings-action:hover { border-color: var(--accent); }

/* #3 role-scopes matrix */
.scopes-table th, .scopes-table td { font-size: 11px; padding: 3px 6px; text-align: center; }
.scopes-table td:first-child, .scopes-table th:first-child { text-align: left; }
.scope-yes { color: #2f9e44; font-weight: 800; }
.scope-no { color: transparent; }

/* v2.31.0 — GH Logistics royal-blue pill in Matrix cells */
.gh-pill { background: #1e3a8a; color: #fff; border-radius: 6px; padding: 0 6px; font-weight: 800; white-space: nowrap; }

/* ================= v2.32.0 — Caleb's app-walk batch ================= */
/* 1. QA glow: MISSING? cells + tendered loads cancelled without a reason */
@keyframes qa-pulse {
  0%, 100% { box-shadow: inset 0 0 0 2px #e5484d, 0 0 6px 1px color-mix(in srgb, #e5484d 55%, transparent); }
  50% { box-shadow: inset 0 0 0 2px #e5484d, 0 0 14px 4px color-mix(in srgb, #e5484d 85%, transparent); }
}
td.cell.qa-glow { animation: qa-pulse 1.6s ease-in-out infinite; }
td.cell.qa-glow .c-missing-sub { color: #e5484d; font-weight: 800; }

/* 3/4. chip rows + jump tags */
.chip-row-label { font-size: 10.5px; font-weight: 800; letter-spacing: 0.4px; opacity: 0.65; margin-right: 2px; white-space: nowrap; }
.jump-label { margin-left: 14px; }
.chip-jump { border-style: dashed; font-weight: 700; }
tr[data-jump], .section-row { scroll-margin-top: 64px; }

/* 7. Sales Hub density: ~half the vertical padding, tighter lines */
.hub-table td { padding: 4px 8px; line-height: 1.3; }
.hub-table th { padding: 4px 8px; }

/* 8/9. labeled row toggles */
.row-toggles { gap: 4px; }
.row-toggles .tog {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  font-size: 8.5px;
  line-height: 1.15;
  font-weight: 700;
  opacity: 0.75;
  cursor: pointer;
  white-space: nowrap;
  text-align: center;
}
.row-toggles .tog.tog-on { opacity: 1; }
.row-toggles .tog.tog-soft span { color: #b08900; }
button.hide-toggle.tog { flex-direction: column; gap: 0; font-size: 8.5px; border: 1px solid var(--border); border-radius: 6px; padding: 1px 5px; }
button.hide-toggle.is-hidden { border-color: #e5484d; color: #e5484d; }

/* 10. hub site rows pop a little */
.site-row td {
  background: color-mix(in srgb, var(--accent) 16%, var(--head-bg));
  border-left: 3px solid var(--accent);
  border-radius: 4px;
}

/* 11/12. Integrity density + frozen header + Loading dropdown unclipped */
.integrity-table th, .integrity-table td { padding: 3px 8px; font-size: 11.5px; line-height: 1.3; }
.integrity-scroll { max-height: calc(100vh - 250px); overflow: auto; }
.integrity-table { overflow: visible; } /* .list-table overflow:hidden killed the sticky header */
.integrity-table thead th {
  position: sticky;
  top: 0;
  background: var(--head-bg);
  z-index: 6;
  box-shadow: 0 1px 0 var(--border);
}
.integrity-table .equip-select { min-width: 250px; }

/* 13. T&T density — mirrors the Trailers tab exactly (v2.32.1: buttons,
   checkboxes and selects were the real row-height drivers, not the padding) */
.track-table th, .track-table td { padding: 1px 6px; font-size: 11.5px; line-height: 1.25; white-space: nowrap; vertical-align: middle; }
.track-table td.wrap { white-space: nowrap; max-width: 240px; overflow: hidden; text-overflow: ellipsis; }
.track-table button, .track-table .btn-ghost, .track-table .btn-approve {
  padding: 0 5px;
  font-size: 10.5px;
  line-height: 1.5;
  min-height: 0;
}
.track-table input[type="checkbox"] { margin: 0; }
.track-table select { padding: 0 4px; font-size: 10.5px; }

/* 14. Admin collapsible user groups + search */
.team-subhead td { cursor: pointer; user-select: none; }
.team-subhead .grp-arrow { display: inline-block; width: 14px; }
.user-search { margin: 6px 0; }

/* 15. Role scopes — wider, wrapped headers, editable grid */
.scopes-modal { max-width: min(97vw, 1560px); width: 97vw; }
.scopes-table th { white-space: normal; font-size: 10.5px; vertical-align: bottom; line-height: 1.2; padding: 6px 4px; }
.scopes-table td:first-child, .scopes-table th:first-child { min-width: 470px; width: 470px; text-align: left; }
.scopes-table td { text-align: center; padding: 2px 4px; font-size: 12px; }
.scopes-table td.wrap { text-align: left; }
.scope-yes { color: #2f9e44; font-weight: 800; }
.scopes-table input[type="checkbox"] { accent-color: var(--accent); }

/* ================= v2.32.3 — .table-dense =================
   THE Trailers-tab density recipe (Caleb: "I like it — replicate it").
   Four ingredients: 2px/6px cell padding, 11.5px @ 1.3 line-height, hard
   single-line rule (nowrap + ellipsis on .wrap cells), and flattened
   controls (buttons/selects/checkboxes are the hidden row-height drivers).
   Apply by adding `table-dense` next to `list-table`. */
.table-dense th, .table-dense td {
  padding: 2px 6px;
  font-size: 11.5px;
  line-height: 1.3;
  white-space: nowrap;
  vertical-align: middle;
}
.table-dense td.wrap { white-space: nowrap; max-width: 260px; overflow: hidden; text-overflow: ellipsis; }
.table-dense button, .table-dense .btn-ghost, .table-dense .btn-approve, .table-dense .btn-primary {
  padding: 0 6px;
  font-size: 10.5px;
  line-height: 1.5;
  min-height: 0;
}
.table-dense select, .table-dense .inline-select { padding: 0 4px; font-size: 10.5px; }
.table-dense input[type="checkbox"] { margin: 0; }
.table-dense .inline-input { padding: 1px 5px; font-size: 11px; }

/* ============ v2.32.4 — density: Sales Hub + Integrity (Caleb) ============
   Hub gets the dense paddings/fonts/flattened controls BUT keeps text
   wrapping in Lane/Notes — rule 8: hub text is never clipped (Caleb
   screenshots it for carrier blasts). */
.hub-table td, .hub-table th { padding: 2px 6px; font-size: 11.5px; line-height: 1.3; }
.hub-table td { white-space: normal; } /* wrap allowed — never clip (rule 8) */
.hub-table td:first-child { white-space: nowrap; }
.hub-table button, .hub-table .btn-ghost, .hub-table .btn-approve, .hub-table .btn-primary {
  padding: 0 6px; font-size: 10.5px; line-height: 1.6; min-height: 0;
}
.hub-table .equip-select, .hub-table .inline-select { padding: 0 4px; font-size: 10.5px; min-width: 0; max-width: 100%; }
.hub-table .inline-input { padding: 1px 5px; font-size: 11px; }
.hub-table textarea { font-size: 11px; }
.note-log { max-height: 64px; gap: 2px; }
.note-line { font-size: 10.5px; line-height: 1.25; }
.offer-card { gap: 2px; padding: 4px 8px; font-size: 11px; }
.hub-banner { padding: 5px 12px; font-size: 12px; }
.site-row td { padding: 4px 8px 3px; }

/* Integrity rates: match the recipe exactly (was 3px/8px) + flat controls */
.integrity-table th, .integrity-table td { padding: 2px 6px; }
.integrity-table button, .integrity-table .btn-ghost { padding: 0 6px; font-size: 10.5px; min-height: 0; }
.integrity-table .inline-input, .integrity-table .band-input { padding: 1px 5px; font-size: 11px; }
